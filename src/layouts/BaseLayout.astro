---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'データ復旧ジャーナルは、HDD・SSD・USBメモリ・NAS・RAIDなどのデータ障害に関する情報を発信する専門メディアです。復旧事例や症状別の対処法、業者選びのポイントまで、データを取り戻すために役立つ情報をわかりやすくお届けします。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header>
      <div class="container">
        <a href="/">データ復旧ジャーナル</a>
        <nav>
          <a href="/posts/">記事一覧</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>
  </body>
</html>

<style>
  :global(html) {
    font-family: sans-serif;
    line-height: 1.7;
  }

  :global(body) {
    margin: 0;
    color: #111;
    background: #fff;
  }

  header {
    border-bottom: 1px solid #ddd;
  }

  .container {
    max-width: 860px;
    margin: 0 auto;
    padding: 16px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  nav {
    margin-top: 8px;
    display: flex;
    gap: 16px;
  }
</style>